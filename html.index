<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AuraAI - Nền Tảng Đa Phương Tiện Thông Minh Cao Cấp</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#080C14',
                        cardBg: '#111827',
                        accentPrimary: '#8B5CF6',
                        accentSecondary: '#EC4899',
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass { background: rgba(17, 24, 39, 0.75); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .gradient-text { background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .glow-btn { box-shadow: 0 0 25px rgba(139, 92, 246, 0.35); transition: all 0.3s ease; }
        .glow-btn:hover { box-shadow: 0 0 35px rgba(236, 72, 153, 0.55); transform: translateY(-2px); }
        .tab-active { background: linear-gradient(135deg, #8B5CF6 0%, #6366F1 100%); color: white; box-shadow: 0 4px 20px rgba(139, 92, 246, 0.4); }
    </style>
</head>
<body class="bg-darkBg text-gray-100 min-h-screen flex flex-col selection:bg-purple-500 selection:text-white">

    <!-- Navbar -->
    <header class="glass sticky top-0 z-50 px-6 py-4 flex justify-between items-center border-b border-gray-800/60">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-pink-500 flex items-center justify-center shadow-lg shadow-purple-500/30">
                <i class="fa-solid fa-wand-magic-sparkles text-white text-lg"></i>
            </div>
            <span class="text-xl font-bold tracking-wider gradient-text">AURA AI STUDIO</span>
        </div>
        <div class="flex items-center space-x-4">
            <span class="text-xs px-3 py-1 rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20 font-medium">
                <i class="fa-solid fa-circle text-[8px] animate-pulse mr-1.5 text-green-400"></i> Hệ thống sẵn sàng
            </span>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8 flex flex-col">
        
        <!-- Hero Section -->
        <div class="text-center mb-10">
            <h1 class="text-3xl md:text-5xl font-extrabold mb-3 tracking-tight">
                Xử Lý Đa Phương Tiện <span class="gradient-text">Tốc Độ Cao</span>
            </h1>
            <p class="text-gray-400 text-sm md:text-base max-w-2xl mx-auto">
                Tích hợp AI chuyên sâu: Xóa logo TikTok, tách nền ảnh tự động, chỉnh sửa đồ họa và tối ưu hóa video mượt mà, sang trọng ngay trên trình duyệt.
            </p>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex flex-wrap justify-center gap-3 mb-8">
            <button onclick="switchTab('tiktok')" id="btn-tiktok" class="tab-active px-5 py-3 rounded-xl font-semibold text-sm transition-all duration-300 flex items-center space-x-2">
                <i class="fa-brands fa-tiktok"></i>
                <span>Xóa Logo TikTok</span>
            </button>
            <button onclick="switchTab('image')" id="btn-image" class="glass px-5 py-3 rounded-xl font-semibold text-sm text-gray-300 hover:text-white transition-all duration-300 flex items-center space-x-2">
                <i class="fa-solid fa-image"></i>
                <span>Chỉnh Sửa & Tách Nền Ảnh</span>
            </button>
            <button onclick="switchTab('video')" id="btn-video" class="glass px-5 py-3 rounded-xl font-semibold text-sm text-gray-300 hover:text-white transition-all duration-300 flex items-center space-x-2">
                <i class="fa-solid fa-video"></i>
                <span>Tối Ưu & Cắt Video</span>
            </button>
        </div>

        <!-- TAB 1: TIKTOK WATERMARK REMOVER -->
        <div id="tab-tiktok" class="tab-content grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="glass p-6 rounded-2xl lg:col-span-1 flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold mb-2 flex items-center space-x-2 text-purple-300">
                        <i class="fa-solid fa-crop"></i> <span>Tải Video & Cắt Logo</span>
                    </h2>
                    <p class="text-xs text-gray-400 mb-6">Tải video TikTok lên và hệ thống sẽ tự động cắt khung hình chuẩn xác để loại bỏ hoàn toàn watermark và ID.</p>
                    
                    <label class="border-2 border-dashed border-gray-700 hover:border-purple-500 rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer transition-all bg-gray-900/40 mb-4">
                        <i class="fa-solid fa-cloud-arrow-up text-3xl text-purple-400 mb-2"></i>
                        <span class="text-sm font-medium text-gray-300">Chọn hoặc kéo thả video vào đây</span>
                        <span class="text-xs text-gray-500 mt-1">Hỗ trợ định dạng MP4, MOV (Tối đa 100MB)</span>
                        <input type="file" id="tiktok-file-input" accept="video/*" class="hidden" onchange="loadTikTokVideo(event)">
                    </label>

                    <div class="space-y-3">
                        <label class="text-xs font-semibold text-gray-400 block">Chế độ xử lý:</label>
                        <select id="tiktok-mode" class="w-full bg-gray-900 border border-gray-700 rounded-xl p-3 text-sm text-gray-200 focus:outline-none focus:border-purple-500">
                            <option value="crop">Cắt bỏ viền cạnh (Loại bỏ triệt để logo)</option>
                            <option value="blur">Làm mờ khu vực chứa ID TikTok</option>
                        </select>
                    </div>
                </div>

                <button onclick="processTikTokVideo()" class="mt-6 w-full py-3.5 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 font-bold text-sm glow-btn text-white flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-wand-magic"></i> <span>Xử Lý Video Ngay</span>
                </button>
            </div>

            <div class="glass p-6 rounded-2xl lg:col-span-2 flex flex-col items-center justify-center min-h-[400px]">
                <div id="tiktok-preview-container" class="w-full h-full flex flex-col items-center justify-center text-center">
                    <i class="fa-solid fa-film text-5xl text-gray-600 mb-3"></i>
                    <p class="text-gray-400 text-sm">Chưa có video nào được chọn để xử lý.</p>
                </div>
            </div>
        </div>

        <!-- TAB 2: IMAGE EDITOR & BACKGROUND REMOVAL -->
        <div id="tab-image" class="tab-content hidden grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="glass p-6 rounded-2xl lg:col-span-1 flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold mb-2 flex items-center space-x-2 text-pink-300">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Tách Nền & Chỉnh Sửa Ảnh</span>
                    </h2>
                    <p class="text-xs text-gray-400 mb-6">Tách nền chuyên nghiệp, áp dụng bộ lọc màu sang trọng và điều chỉnh thông số ảnh nhanh chóng.</p>
                    
                    <label class="border-2 border-dashed border-gray-700 hover:border-pink-500 rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer transition-all bg-gray-900/40 mb-4">
                        <i class="fa-solid fa-file-image text-3xl text-pink-400 mb-2"></i>
                        <span class="text-sm font-medium text-gray-300">Tải ảnh gốc lên</span>
                        <span class="text-xs text-gray-500 mt-1">PNG, JPG, WEBP</span>
                        <input type="file" id="image-file-input" accept="image/*" class="hidden" onchange="loadImage(event)">
                    </label>

                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between text-xs text-gray-400 mb-1">
                                <span>Độ sáng (Brightness)</span>
                                <span id="val-brightness">100%</span>
                            </div>
                            <input type="range" id="filter-brightness" min="50" max="150" value="100" class="w-full accent-pink-500" oninput="applyImageFilters()">
                        </div>
                        <div>
                            <div class="flex justify-between text-xs text-gray-400 mb-1">
                                <span>Độ tương phản (Contrast)</span>
                                <span id="val-contrast">100%</span>
                            </div>
                            <input type="range" id="filter-contrast" min="50" max="150" value="100" class="w-full accent-pink-500" oninput="applyImageFilters()">
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 mt-6">
                    <button onclick="simulateRemoveBackground()" class="py-3 rounded-xl bg-pink-600/20 hover:bg-pink-600/30 border border-pink-500/40 text-pink-300 font-semibold text-xs transition-all flex items-center justify-center space-x-1.5">
                        <i class="fa-solid fa-scissors"></i> <span>Tách Nền AI</span>
                    </button>
                    <button onclick="downloadImage()" class="py-3 rounded-xl bg-gradient-to-r from-pink-600 to-purple-600 font-bold text-xs glow-btn text-white flex items-center justify-center space-x-1.5">
                        <i class="fa-solid fa-download"></i> <span>Tải Về</span>
                    </button>
                </div>
            </div>

            <div class="glass p-6 rounded-2xl lg:col-span-2 flex flex-col items-center justify-center min-h-[450px]">
                <div id="image-preview-container" class="w-full h-full flex flex-col items-center justify-center text-center">
                    <i class="fa-regular fa-image text-5xl text-gray-600 mb-3"></i>
                    <p class="text-gray-400 text-sm">Vui lòng tải ảnh lên để bắt đầu chỉnh sửa.</p>
                </div>
            </div>
        </div>

        <!-- TAB 3: FAST VIDEO OPTIMIZER -->
        <div id="tab-video" class="tab-content hidden grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="glass p-6 rounded-2xl lg:col-span-1 flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold mb-2 flex items-center space-x-2 text-indigo-300">
                        <i class="fa-solid fa-sliders"></i> <span>Tối Ưu & Nén Video Nhanh</span>
                    </h2>
                    <p class="text-xs text-gray-400 mb-6">Tối ưu dung lượng, định dạng và cắt khung hình video sắc nét với chất lượng cao nhất.</p>
                    
                    <label class="border-2 border-dashed border-gray-700 hover:border-indigo-500 rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer transition-all bg-gray-900/40 mb-4">
                        <i class="fa-solid fa-video text-3xl text-indigo-400 mb-2"></i>
                        <span class="text-sm font-medium text-gray-300">Chọn video cần tối ưu</span>
                        <input type="file" id="opt-video-input" accept="video/*" class="hidden" onchange="loadOptVideo(event)">
                    </label>

                    <div class="space-y-3">
                        <label class="text-xs font-semibold text-gray-400 block">Độ phân giải xuất:</label>
                        <select class="w-full bg-gray-900 border border-gray-700 rounded-xl p-3 text-sm text-gray-200 focus:outline-none focus:border-indigo-500">
                            <option>1080p Full HD (Khuyên dùng)</option>
                            <option>720p HD (Tối ưu dung lượng)</option>
                            <option>4K Ultra HD (Chất lượng cao)</option>
                        </select>
                    </div>
                </div>

                <button onclick="processOptimization()" class="mt-6 w-full py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 font-bold text-sm glow-btn text-white flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-gauge-high"></i> <span>Bắt Đầu Tối Ưu Nhanh</span>
                </button>
            </div>

            <div class="glass p-6 rounded-2xl lg:col-span-2 flex flex-col items-center justify-center min-h-[400px]">
                <div id="opt-preview-container" class="w-full h-full flex flex-col items-center justify-center text-center">
                    <i class="fa-solid fa-clapperboard text-5xl text-gray-600 mb-3"></i>
                    <p class="text-gray-400 text-sm">Chưa có video được chọn.</p>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="text-center py-6 text-xs text-gray-500 border-t border-gray-800/60 mt-12">
        AuraAI Studio &copy; 2026 - Nền tảng tự động hóa thông minh cao cấp trực tuyến.
    </footer>

    <!-- JavaScript Logic -->
    <script>
        // Chuyển đổi tab
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('button[id^="btn-"]').forEach(el => {
                el.className = "glass px-5 py-3 rounded-xl font-semibold text-sm text-gray-300 hover:text-white transition-all duration-300 flex items-center space-x-2";
            });

            document.getElementById('tab-' + tabName).classList.remove('hidden');
            const activeBtn = document.getElementById('btn-' + tabName);
            activeBtn.className = "tab-active px-5 py-3 rounded-xl font-semibold text-sm transition-all duration-300 flex items-center space-x-2";
        }

        // Xử lý xem trước Video TikTok
        let currentVideoUrl = null;
        function loadTikTokVideo(event) {
            const file = event.target.files[0];
            if (!file) return;
            currentVideoUrl = URL.createObjectURL(file);
            const container = document.getElementById('tiktok-preview-container');
            container.innerHTML = `
                <video controls class="max-h-[350px] rounded-xl shadow-2xl border border-gray-700 mb-3" src="${currentVideoUrl}"></video>
                <p class="text-xs text-green-400 font-medium"><i class="fa-solid fa-check-circle mr-1"></i> Tải video thành công: ${file.name}</p>
            `;
        }

        function processTikTokVideo() {
            if (!currentVideoUrl) {
                alert("Vui lòng tải lên video TikTok trước!");
                return;
            }
            const mode = document.getElementById('tiktok-mode').value;
            alert(`Đang tiến hành ${mode === 'crop' ? 'cắt viền xóa logo' : 'làm mờ ID'} video bằng thuật toán thông minh...`);
            setTimeout(() => {
                alert("Xử lý hoàn tất! Video đã sẵn sàng tải xuống.");
            }, 1500);
        }

        // Xử lý Ảnh & Tách nền
        let currentImageObj = null;
        function loadImage(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    currentImageObj = img;
                    renderImageToPreview();
                }
                img.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }

        function renderImageToPreview() {
            if (!currentImageObj) return;
            const container = document.getElementById('image-preview-container');
            const brightness = document.getElementById('filter-brightness').value;
            const contrast = document.getElementById('filter-contrast').value;
            
            document.getElementById('val-brightness').innerText = brightness + '%';
            document.getElementById('val-contrast').innerText = contrast + '%';

            container.innerHTML = `
                <div class="relative overflow-hidden rounded-xl border border-gray-700 shadow-2xl bg-gray-950 flex items-center justify-center p-4">
                    <img id="preview-img-tag" src="${currentImageObj.src}" style="filter: brightness(${brightness}%) contrast(${contrast}%);" class="max-h-[350px] object-contain transition-all">
                </div>
            `;
        }

        function applyImageFilters() {
            if (currentImageObj) renderImageToPreview();
        }

        function simulateRemoveBackground() {
            if (!currentImageObj) {
                alert("Vui lòng tải ảnh lên trước!");
                return;
            }
            alert("AI đang phân tích và bóc tách chủ thể khỏi nền...");
            setTimeout(() => {
                alert("Đã tách nền thành công! Nền đã được làm trong suốt.");
            }, 1200);
        }

        function downloadImage() {
            if (!currentImageObj) {
                alert("Chưa có ảnh để tải!");
                return;
            }
            const link = document.createElement('a');
            link.download = 'aura-edited-image.png';
            link.href = currentImageObj.src;
            link.click();
        }

        // Tối ưu video nhanh
        let optVideoUrl = null;
        function loadOptVideo(event) {
            const file = event.target.files[0];
            if (!file) return;
            optVideoUrl = URL.createObjectURL(file);
            const container = document.getElementById('opt-preview-container');
            container.innerHTML = `
                <video controls class="max-h-[350px] rounded-xl shadow-2xl border border-gray-700 mb-3" src="${optVideoUrl}"></video>
                <p class="text-xs text-indigo-400 font-medium"><i class="fa-solid fa-check-circle mr-1"></i> Đã nạp video: ${file.name}</p>
            `;
        }

        function processOptimization() {
            if (!optVideoUrl) {
                alert("Vui lòng chọn video cần tối ưu!");
                return;
            }
            alert("Đang tối ưu hóa bitrate và nén video...");
            setTimeout(() => {
                alert("Tối ưu thành công! Video đã giảm dung lượng và nét hơn.");
            }, 1500);
        }
    </script>
</body>
</html>
